     owmapgen flag: map-option MAP_OPTIONS_MULTI_CALDERA_MOAT=MAP_OPTION_CALDERA_DESERT -->
<Root>
  <Entry>
    <zType>MAP_OPTIONS_MULTI_CALDERA_MOAT</zType>
    <Name>TEXT_MAP_OPTIONS_MULTI_CALDERA_MOAT</Name>
