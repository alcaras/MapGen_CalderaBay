<?xml version="1.0"?>
<!-- FlatLush is registered the simple way: an XML mapClass entry whose
     <zScriptType> names the C# class. This works, BUT an XML mapClass entry
     CANNOT carry custom map options (InfoMapClass.Read ignores them) — the
     engine only attaches a script's GetCustomOptions* when it auto-imports the
     class by REFLECTION, and reflection only runs for types whose namespace is
     empty / "TenCrowns.GameCore" / == the mod's ModName.

     Caldera Bay needs its Climate + Point-Symmetry options, so it is NOT listed
     here: it lives in the global namespace and is registered purely by
     reflection (see src/CalderaBay.cs, which declares GetName/GetHelp/
     AllowMirror/GetCustomOptions*). Listing it here too would have created a
     second, option-less duplicate entry. -->
<Root>
  <Entry>
    <zType>MAPCLASS_FLATLUSH</zType>
    <Name>TEXT_MAPCLASS_FLATLUSH</Name>
    <Help>TEXT_MAPCLASS_FLATLUSH_HELP</Help>
    <zScriptType>MapScriptFlatLush</zScriptType>
    <bAllowMirror>1</bAllowMirror>
  </Entry>
</Root>
